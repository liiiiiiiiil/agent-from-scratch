+import os
+import sys
+import unittest
+
+sys.path.insert(
+    0,
+    os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"),
+)
+
+from cache import ExpiringCache
+
+
+class FakeClock:
+    """可控时钟：让测试精确推进时间，不依赖真实时钟。"""
+
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+class CacheExpiryBoundaryTests(unittest.TestCase):
+    def test_value_returned_before_expiry(self):
+        clock = FakeClock()
+        cache = ExpiringCache(ttl_seconds=10, clock=clock)
+        cache.put("k", "v")
+
+        clock.advance(9.999)
+
+        self.assertEqual(cache.get("k"), "v")
+
+    def test_value_expired_exactly_at_ttl(self):
+        clock = FakeClock()
+        cache = ExpiringCache(ttl_seconds=10, clock=clock)
+        cache.put("k", "v")
+
+        clock.advance(10)
+
+        self.assertIsNone(cache.get("k"))
+
+    def test_expired_entry_stays_gone_after_boundary(self):
+        clock = FakeClock()
+        cache = ExpiringCache(ttl_seconds=10, clock=clock)
+        cache.put("k", "v")
+
+        clock.advance(10)
+        self.assertIsNone(cache.get("k"))
+
+        clock.advance(5)
+        self.assertIsNone(cache.get("k"))
+
+
+if __name__ == "__main__":
+    unittest.main()
